# Quantflow Environment Variables
# Copy this file to .env and fill in your values
# .env file is ignored by git (safe for secrets)

# =============================================================================
# Tushare API Token (REQUIRED for Tushare data source)
# =============================================================================
# Tushare is used as fallback data source for A-share stocks.
# 
# How to get your token:
#   1. Register at: https://tushare.pro/register
#   2. Get token at: https://tushare.pro/user/token
#
# Configuration priority:
#   1. Environment variable (highest) - export TUSHARE_TOKEN="..."
#   2. .env file (recommended)        - copy this file to .env
#   3. config/quantflow.yaml (lowest)  - tushare.token field
# =============================================================================
TUSHARE_TOKEN=your_token_here

# Optional: Override data source config path
# QUANTFLOW_CONFIG_PATH=./config/quantflow.yaml