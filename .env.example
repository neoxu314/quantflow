# Sample shell assignment for the optional Tushare provider.
# For an interactive shell, export TUSHARE_TOKEN before starting QuantFlow.
# To load a copy from .env, run this in the same shell that starts QuantFlow:
#   set -a
#   . ./.env
#   set +a
# QuantFlow reads the process environment and config/quantflow.yaml only.
# A non-empty environment value takes precedence over tushare.token in YAML.
# Keep real credentials out of the repository.

TUSHARE_TOKEN=your_token_here
